# Copy to .env only if you want the OPTIONAL local model. The app works fully without it.
# No API keys are used. Only a local Ollama server (free, runs on your machine) is supported.
#
# NORBAE_LLM_PROVIDER=none        # none (default) | ollama
# NORBAE_OLLAMA_MODEL=llama3.1:8b # any model you have pulled with `ollama pull`
# NORBAE_OLLAMA_URL=http://localhost:11434   # must be localhost
# NORBAE_PORT=8501
NORBAE_LLM_PROVIDER=none
